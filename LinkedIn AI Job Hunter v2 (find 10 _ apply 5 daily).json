    {
      "parameters": {
        "jsCode": "const t = $input.first().json.choices[0].message.content;\nconst m = t.match(/\\{[\\s\\S]*\\}/);\nif (!m) throw new Error('CV analysis returned no JSON');\nconst p = JSON.parse(m[0]);\nif (!Array.isArray(p.job_titles) || !p.job_titles.length || !p.keywords) {\n  throw new Error('CV analysis returned an unusable profile: ' + m[0].slice(0, 200));\n}\nreturn [{ json: p }];"
      },
