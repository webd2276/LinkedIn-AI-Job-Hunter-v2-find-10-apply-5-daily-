    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst jobs = $('Pick New Jobs').all();\nconst scored = $input.all().map((r, i) => {\n  let a = { score: 0, reason: 'scoring failed', cover_letter: '' };\n  try {\n    const txt = r.json.choices[0].message.content;\n    const p = JSON.parse(txt.match(/\\{[\\s\\S]*\\}/)[0]);\n    a = { score: Number(p.score) || 0, reason: String(p.reason || ''), cover_letter: String(p.cover_letter || '') };\n  } catch (e) {}\n  if (jobs[i] && jobs[i].json.requeued) a.score = Math.max(a.score, Number(jobs[i].json.prev_score) || 0);\n  return { ...jobs[i].json, ...a, date: new Date().toISOString().slice(0, 10) };\n});\nscored.sort((x, y) => y.score - x.score);\nlet n = 0;\nreturn scored.map(j => {\n  const ok = j.score >= cfg.min_score && !!j.cover_letter && n < cfg.apply_limit;\n  if (ok) n++;\n  const status = ok ? 'queued' : (j.score < cfg.min_score ? 'below_threshold' : 'found');\n  return { json: { ...j, to_apply: ok, status } };\n});"
      },
