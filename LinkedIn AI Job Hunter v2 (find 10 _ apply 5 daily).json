      "id": "7aa20168-9b72-4200-99de-cf2baa79b13f",
      "name": "Score + Cover Letter (Pollinations)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2016,
        560
      ],
      "retryOnFail": true,
