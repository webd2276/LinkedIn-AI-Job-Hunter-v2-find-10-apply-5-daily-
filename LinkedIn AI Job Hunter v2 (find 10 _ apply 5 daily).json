    {
      "parameters": {
        "jsCode": "// Field names depend on your Apify actor. Adjust url/title/company/description mapping below.\nconst cfg = $('Config').first().json;\nconst norm = s => String(s || '').toLowerCase().trim();\nconst seen = new Set();\nfor (const r of $('Read Jobs Log').all()) {\n  if (r.json.job_url) seen.add(r.json.job_url);\n  if (r.json.title) seen.add(norm(r.json.company) + '|' + norm(r.json.title));\n}\nconst badCo = norm(cfg.exclude_companies).split(',').map(s => s.trim()).filter(Boolean);\nconst badWords = norm(cfg.exclude_title_words).split(',').map(s => s.trim()).filter(Boolean);\nconst out = [];\nfor (const i of $('Search LinkedIn Jobs').all()) {\n  const j = i.json;\n  const url = String(j.link || j.url || j.jobUrl || '').split('?')[0];\n  const title = j.title || j.jobTitle;\n  const company = j.companyName || j.company;\n  if (!url || !title) continue;\n  const key = norm(company) + '|' + norm(title);\n  if (seen.has(url) || seen.has(key)) continue;\n  if (badCo.some(c => norm(company).includes(c))) continue;\n  if (badWords.some(w => norm(title).includes(w))) continue;\n  seen.add(url); seen.add(key);\n  out.push({ json: { title, company, job_url: url, description: String(j.description || j.descriptionText || '').slice(0, 3000) } });\n  if (out.length >= cfg.find_limit) break;\n}\n// Re-queue jobs already in the sheet with status 'queued' (never applied yet)\nconst queuedRows = $('Read Jobs Log').all().filter(r => ['queued', 'error'].includes(norm(r.json.status)) && r.json.job_url).slice(0, cfg.apply_limit);\nfor (const r of queuedRows) {\n  out.push({ json: { title: r.json.title, company: r.json.company, job_url: String(r.json.job_url).split('?')[0], description: '', prev_score: Number(r.json.score) || 0, requeued: true } });\n}\nreturn out.length ? out : [{ json: { _empty: true } }];"
      },
