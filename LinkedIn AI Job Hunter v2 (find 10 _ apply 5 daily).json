    {
      "parameters": {
        "jsCode": "const queue = $('Filter To Apply').all().map(i => i.json);\nreturn $input.all().map((r, i) => {\n  const j = queue[i] || {};\n  const out = r.json || {};\n  const txt = JSON.stringify(out);\n  let status = 'error';\n  let note = '';\n  if (out.error) {\n    note = 'browser error: ' + String(out.error.message || out.error).slice(0, 150);\n  } else if (/RESULT:\\s*APPLIED/i.test(txt)) {\n    status = 'applied';\n  } else if (/RESULT:\\s*SKIPPED/i.test(txt)) {\n    status = 'manual_needed';\n    const m = txt.match(/RESULT:\\s*SKIPPED\\s*-?\\s*([^\"\\\\]{0,200})/i);\n    note = m ? m[1] : 'skipped';\n  } else {\n    note = 'no clear result: ' + txt.slice(0, 150);\n  }\n  return { json: { ...j, status, note } };\n});"
      },
